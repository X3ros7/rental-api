PROJECT_NAME           = "RentAI API"
PROJECT_BRIEF          = "Rental management REST API with Bearer JWT"
PROJECT_NUMBER         = 1.0.0
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

INPUT                  = app docs/mainpage.md
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
EXCLUDE                = app/__pycache__ app/routers/__pycache__
EXCLUDE_PATTERNS       = */__pycache__/* */.venv/* */venv/*

USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO

PYTHON_DOCSTRING       = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTENSION_MAPPING      = py=Python
EXTRACT_PACKAGE        = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE_HUE    = 210
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_DYNAMIC_MENUS     = YES
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO

HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = NO
